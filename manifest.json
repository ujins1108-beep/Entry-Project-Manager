{
    "manifest_version":  3,
    "name":  "Entry Project Manager",
    "version":  "1.9.0",
    "description":  "엔트리 작품 관리를 쉽게 할 수 있게 해주는 확장 프로그램입니다.",
    "icons":  {
                  "16":  "EPM-icon-16.png",
                  "48":  "EPM-icon-48.png",
                  "128":  "EPM-icon-128.png"
              },
    "permissions":  [
                        "activeTab",
                        "storage"
                    ],
    "action":  {
                   "default_title":  "Entry Project Manager",
                   "default_icon":  {
                                        "16":  "EPM-icon-16.png",
                                        "48":  "EPM-icon-48.png",
                                        "128":  "EPM-icon-128.png"
                                    }
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://playentry.org/*"
                                            ],
                                "js":  [
                                           "page-bridge.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "https://playentry.org/profile/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "EPM-icon-48.png"
                                                       ],
                                         "matches":  [
                                                         "https://playentry.org/*"
                                                     ]
                                     }
                                 ],
    "host_permissions":  [
                             "https://playentry.org/*"
                         ]
}